{
  "id": "metacore_delta_harness_contract_v1",
  "version": "1.0.0",
  "status": "PUBLIC_TEST_BOUNDARY",
  "purpose": "Define the public black-box and contract-level verification boundary for MetaCore without distributing private MetaCore OS bridge implementation.",
  "core_invariant": "PUBLIC_TESTABILITY_DOES_NOT_REQUIRE_PRIVATE_IMPLEMENTATION_DISCLOSURE",
  "allowed_test_surfaces": [
    "public contracts",
    "public routing behavior",
    "public schemas",
    "declared input/output compatibility",
    "public-safe fixtures",
    "public result envelopes"
  ],
  "forbidden_surfaces": [
    "private bridge source",
    "protected LAB topology",
    "credentials or secret material",
    "tenant/person/company private state",
    "private runtime configuration"
  ],
  "test_modes": [
    "CONTRACT_VALIDATION",
    "BLACK_BOX_BEHAVIOR",
    "COMPATIBILITY_DELTA",
    "REGRESSION_DELTA"
  ],
  "result_rule": "A public DELTA result may describe compatibility or observed behavior, but it does not reveal or require the private implementation that produced it.",
  "specific_tests": "TO_BE_DEFINED_SEPARATELY"
}
