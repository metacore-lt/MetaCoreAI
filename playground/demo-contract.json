{
  "id": "metacore_context_lab_demo_contract_v1",
  "version": "2.0.0",
  "status": "PUBLIC_BROWSER_LOCAL_PREMIUM",
  "execution": {
    "location": "browser",
    "network_calls": false,
    "B1_calls": false,
    "database_writes": false,
    "private_runtime": false
  },
  "operations": {
    "context_compile": {
      "method": "POST",
      "path": "/demo/v1/context/compile",
      "input": "bounded public signal objects",
      "output": "theme weights + confidence bands + unknowns + prompts"
    },
    "state_delta": {
      "method": "POST",
      "path": "/demo/v1/state/delta",
      "input": "before and after JSON objects",
      "output": "added/removed/changed/unchanged key paths"
    },
    "epistemic_route": {
      "method": "POST",
      "path": "/demo/v1/epistemic/route",
      "input": "claim provenance/freshness/support flags",
      "output": "public epistemic class + explanation"
    },
    "authority_check": {
      "method": "POST",
      "path": "/demo/v1/authority/check",
      "input": "actor/auth/mandate/scope/impact/approval policy",
      "output": "ALLOW / NEEDS_APPROVAL / BLOCK + reasons"
    },
    "personal_seed": {
      "method": "POST",
      "path": "/demo/v1/personal/seed",
      "input": "birth date + city + optional birth time",
      "output": "provenance envelope + precision gate"
    },
    "symbolic_matrix": {
      "method": "POST",
      "path": "/demo/v1/personal/symbolic-matrix",
      "input": "birth date",
      "output": "transparent Pythagorean-style symbolic matrix preview"
    },
    "personal_reflection": {
      "method": "POST",
      "path": "/demo/v1/personal/reflection",
      "input": "symbolic matrix summary",
      "output": "non-diagnostic symbolic reflection prompts"
    }
  },
  "boundary": "Demo behavior is public and inspectable. Private prompts, routes, bridges, operating-core code and credentials are not present.",
  "live_upgrade": "Separate verified developer boundary; not implemented by this browser demo.",
  "personal_data": {
    "mode": "OPTIONAL",
    "inputs": [
      "birth_date",
      "birth_city",
      "birth_time_optional"
    ],
    "default_birth_time_if_unknown": "12:00",
    "default_time_class": "ASSUMED_NOON",
    "network_transmission": false,
    "persistence": false,
    "cookies": false,
    "local_storage": false
  },
  "symbolic_boundary": "Psychomatrix preview is symbolic/numerological and is not a psychometric assessment, diagnosis, fate claim or empirical personality measurement.",
  "time_precision_boundary": "When birth time is unknown, 12:00 is an explicit demo assumption and time-sensitive astrology claims are withheld."
}
