  "instruments": [
    {
      "id": "context_compile",
      "method": "POST",
      "path": "/demo/v1/context/compile",
      "input": "bounded public signal objects",
      "output": "theme weights + confidence bands + unknowns + prompts"
    },
    {
      "id": "state_delta",
      "method": "POST",
      "path": "/demo/v1/state/delta",
      "input": "before and after JSON objects",
      "output": "added/removed/changed/unchanged key paths"
    },
    {
      "id": "epistemic_route",
      "method": "POST",
      "path": "/demo/v1/epistemic/route",
      "input": "claim provenance/freshness/support flags",
      "output": "public epistemic class + explanation"
    },
    {
      "id": "authority_check",
      "method": "POST",
      "path": "/demo/v1/authority/check",
      "input": "actor/auth/mandate/scope/impact/approval policy",
      "output": "ALLOW / NEEDS_APPROVAL / BLOCK + reasons"
    },
    {
      "id": "personal_seed",
      "method": "POST",
      "path": "/demo/v1/personal/seed",
      "input": "birth date + city + optional birth time",
      "output": "provenance envelope + precision gate"
    },
    {
      "id": "symbolic_matrix",
      "method": "POST",
      "path": "/demo/v1/personal/symbolic-matrix",
      "input": "birth date",
      "output": "transparent Pythagorean-style symbolic matrix preview"
    },
    {
      "id": "personal_reflection",
      "method": "POST",
      "path": "/demo/v1/personal/reflection",
      "input": "symbolic matrix summary",
      "output": "non-diagnostic symbolic reflection prompts"
    },
    {
      "id": "human_loop",
      "method": "POST",
      "path": "/demo/v1/human/loop-map",
      "input": "self-reported trigger + touched need + reaction + breaker + next step",
      "output": "structural loop map + next question or safety stop"
    },
    {
      "id": "team_friction",
      "method": "POST",
      "path": "/demo/v1/team/friction",
      "input": "team type + decision/ownership/communication/rhythm + bottleneck text + next improvement",
      "output": "operational friction snapshot + bottleneck + operator question/action or safety stop"
    },
    {
      "id": "knowledge_route",
      "method": "POST",
      "path": "/demo/v1/knowledge/route",
      "input": "short public question",
      "output": "matching knowledge regions + epistemic classes + conceptual hops + route confidence"
    }
  ],
  "guided_experiments": [
    {
      "id": "unknown",
      "title": "Can the system admit it does not know?",
      "instrument": "epistemic_route",
      "deeplink": "https://delta.metacore.lt/context-lab/?exp=unknown",
      "boundary": "The demo classifies evidence state; it does not generate or verify the missing fact."
    },
    {
      "id": "authority",
      "title": "Can AI keep an authority boundary?",
      "instrument": "authority_check",
      "deeplink": "https://delta.metacore.lt/context-lab/?exp=authority",
