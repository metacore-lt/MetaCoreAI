{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metacore.example/specs/delta-receipt-v0.1.schema.json",
  "title": "MetaCore DELTA Receipt v0.1",
  "type": "object",
  "required": ["run_id", "test_id", "baseline_output_hash", "metacore_output_hash", "metrics", "limitations", "timestamp", "receipt_sha256"],
  "properties": {
    "run_id": {"type": "string"},
    "test_id": {"type": "string"},
    "model_family": {"type": "string"},
    "baseline_output_hash": {"type": "string"},
    "metacore_output_hash": {"type": "string"},
    "blind_assignment": {"type": "string"},
    "metrics": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "timestamp": {"type": "string", "format": "date-time"},
    "receipt_sha256": {"type": "string"}
  },
  "additionalProperties": false
}
