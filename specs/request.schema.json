{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metacore.example/specs/delta-request-v0.2.schema.json",
  "title": "MetaCore DELTA Request v0.2",
  "type": "object",
  "required": [
    "test_id",
    "mode",
    "input"
  ],
  "properties": {
    "client_request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "test_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "mode": {
      "enum": [
        "QUICK_DELTA",
        "BREAK_METACORE",
        "CONTEXT_STRESS",
        "BRING_YOUR_AI"
      ]
    },
    "experiment_class": {
      "enum": [
        "CONTROLLED_DELTA",
        "OBSERVATIONAL_DELTA"
      ],
      "default": "CONTROLLED_DELTA"
    },
    "input": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 20000
        },
        {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "role",
              "content"
            ],
            "properties": {
              "role": {
                "enum": [
                  "user",
                  "assistant"
                ]
              },
              "content": {
                "type": "string",
                "maxLength": 8000
              }
            },
            "additionalProperties": false
          }
        }
      ]
    },
    "baseline": {
      "type": "object",
      "properties": {
        "model_family": {
          "type": "string",
          "maxLength": 128
        },
        "output": {
          "type": "string",
          "maxLength": 40000
        },
        "output_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "run_conditions": {
      "$ref": "conditions.schema.json"
    },
    "publish_result": {
      "type": "boolean",
      "default": false
    }
  },
  "additionalProperties": false
}
