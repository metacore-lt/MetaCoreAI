{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metacore.example/specs/delta-metric-v0.1.schema.json",
  "title": "MetaCore DELTA Metric v0.1",
  "type": "object",
  "required": ["metric_id", "observable_behavior", "method"],
  "properties": {
    "metric_id": {"type": "string"},
    "observable_behavior": {"type": "string"},
    "method": {"enum": ["deterministic", "rubric", "judge", "human_review", "rule+rubric"]},
    "result_type": {"enum": ["PASS_FAIL", "PASS_PARTIAL_FAIL", "COUNT", "NUMBER"]},
    "higher_is_better": {"type": ["boolean", "null"]},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
